# Database
DATABASE_URL=postgresql://user:password@localhost:5433/style_gen

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Gemini
GEMINI_API_KEY=

# fal.ai
FAL_KEY=

# AI Provider 配置
# 模型 → Provider 映射的 SSOT 是 src/lib/ai/models.json（每模型可绑多 provider 并声明默认绑定）。
# 下述 *_PROVIDER 仅在所选模型支持该 provider 时覆盖默认绑定；生图请求未携带 model 时
# 会优先选择该 provider 为默认绑定的模型。
VISION_PROVIDER=replicate          # replicate | gemini
STRUCTURER_PROVIDER=               # optional: replicate | gemini; defaults to VISION_PROVIDER
IMAGE_GEN_PROVIDER=replicate       # replicate | fal | gemini
REPLICATE_API_TOKEN=               # Replicate API 令牌
REPLICATE_WEBHOOK_SECRET=          # Webhook 签名验证密钥
WEBHOOK_BASE_URL=                  # Webhook 回调基地址（开发环境需使用 ngrok 等）

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_REQUIRED=true
